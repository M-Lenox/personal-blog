<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Article - Admin</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>Edit Article</h1>
    <nav>
      <a href="/admin">Back to Dashboard</a>
    </nav>
  </header>

  <main>
    <form action="/admin/edit/<%= article.id %>" method="POST" class="article-form">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" value="<%= article.title %>" required>

      <label for="content">Content</label>
      <textarea name="content" id="content" rows="10" required><%= article.content %></textarea>

      <label for="date">Date of Publication</label>
      <input type="date" name="date" id="date" value="<%= article.date %>" required>

      <button type="submit">Update</button>
    </form>
  </main>
</body>
</html>

<!-- Variables:
article: Object { id, title, content, date }
-->
